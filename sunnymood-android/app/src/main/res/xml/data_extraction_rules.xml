<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ 云备份与换机迁移规则：仅数据库与设置 -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="sunnymood.db" />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="sunnymood.db" />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
