<resources>
    <!-- 主界面主题（跟随系统深浅色由 values-night 覆盖） -->
    <style name="Theme.SunnyMood" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/app_bg</item>
        <item name="android:statusBarColor">@color/app_bg</item>
        <item name="android:navigationBarColor">@color/app_bg</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- 记录面板：透明 + 背景压暗，中央缩放弹出（anim/panel_in） -->
    <style name="Theme.SunnyMood.Panel">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.4</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@style/PanelAnimation</item>
    </style>

    <style name="PanelAnimation">
        <item name="android:windowEnterAnimation">@anim/panel_in</item>
        <item name="android:windowExitAnimation">@anim/panel_out</item>
    </style>
</resources>
