<?xml version="1.0" encoding="utf-8"?>
<!-- 4x2 大图标版（主推）：状态行 + 7 个大图标，触控更从容 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_4x2_label"
            android:textColor="@color/widget_text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tv_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_text_primary"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/cell_mood_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:foreground="?android:attr/selectableItemBackgroundBorderless">

            <ImageView
                android:id="@+id/iv_mood_1"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:contentDescription="@string/app_name"
                android:src="@drawable/mood_1" />

            <View
                android:id="@+id/hl_mood_1"
                android:layout_width="5dp"
                android:layout_height="5dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="2dp"
                android:background="@drawable/hl_dot"
                android:visibility="invisible" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/cell_mood_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:foreground="?android:attr/selectableItemBackgroundBorderless">

            <ImageView
                android:id="@+id/iv_mood_2"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:contentDescription="@string/app_name"
                android:src="@drawable/mood_2" />

            <View
                android:id="@+id/hl_mood_2"
                android:layout_width="5dp"
                android:layout_height="5dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="2dp"
                android:background="@drawable/hl_dot"
                android:visibility="invisible" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/cell_mood_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:foreground="?android:attr/selectableItemBackgroundBorderless">

            <ImageView
                android:id="@+id/iv_mood_3"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:contentDescription="@string/app_name"
                android:src="@drawable/mood_3" />

            <View
                android:id="@+id/hl_mood_3"
                android:layout_width="5dp"
                android:layout_height="5dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="2dp"
                android:background="@drawable/hl_dot"
                android:visibility="invisible" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/cell_mood_4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:foreground="?android:attr/selectableItemBackgroundBorderless">

            <ImageView
                android:id="@+id/iv_mood_4"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:contentDescription="@string/app_name"
                android:src="@drawable/mood_4" />

            <View
                android:id="@+id/hl_mood_4"
                android:layout_width="5dp"
                android:layout_height="5dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="2dp"
                android:background="@drawable/hl_dot"
                android:visibility="invisible" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/cell_mood_5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:foreground="?android:attr/selectableItemBackgroundBorderless">

            <ImageView
                android:id="@+id/iv_mood_5"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:contentDescription="@string/app_name"
                android:src="@drawable/mood_5" />

            <View
                android:id="@+id/hl_mood_5"
                android:layout_width="5dp"
                android:layout_height="5dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="2dp"
                android:background="@drawable/hl_dot"
                android:visibility="invisible" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/cell_mood_6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:foreground="?android:attr/selectableItemBackgroundBorderless">

            <ImageView
                android:id="@+id/iv_mood_6"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:contentDescription="@string/app_name"
                android:src="@drawable/mood_6" />

            <View
                android:id="@+id/hl_mood_6"
                android:layout_width="5dp"
                android:layout_height="5dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="2dp"
                android:background="@drawable/hl_dot"
                android:visibility="invisible" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/cell_mood_7"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:foreground="?android:attr/selectableItemBackgroundBorderless">

            <ImageView
                android:id="@+id/iv_mood_7"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:contentDescription="@string/app_name"
                android:src="@drawable/mood_7" />

            <View
                android:id="@+id/hl_mood_7"
                android:layout_width="5dp"
                android:layout_height="5dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="2dp"
                android:background="@drawable/hl_dot"
                android:visibility="invisible" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
